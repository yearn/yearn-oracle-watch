{
  "name": "@yearn-oracle-watch/contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/wagmi.js",
  "module": "./dist/wagmi.js",
  "types": "./dist/wagmi.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/wagmi.d.ts",
      "import": "./dist/wagmi.js",
      "require": "./dist/wagmi.js",
      "default": "./dist/wagmi.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "5.80.7",
    "@wagmi/cli": "2.3.1",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@types/node": "22.15.32",
    "@wagmi/core": "2.17.3",
    "abitype": "1.0.8",
    "lodash": "4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.33.2",
    "wagmi": "2.15.6"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "build:types": "tsc -p ./tsconfig.build.json",
    "format": "biome format . --write",
    "format-and-lint": "bun run format && bun run lint:fix:unsafe",
    "lint": "biome check .",
    "lint:all": "bun run lint:fix:unsafe && bun run lint:types",
    "lint:fix": "bun run lint --apply",
    "lint:fix:unsafe": "bun run lint --write --unsafe",
    "lint:types": ":",
    "codegen": "wagmi generate && bun run codegen:patch",
    "codegen:patch": "tsx src/codegen-patch.ts"
  }
}
