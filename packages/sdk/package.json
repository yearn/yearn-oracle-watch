{
  "name": "@yearn-oracle-watch/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@yearn-oracle-watch/contracts": "workspace:*",
    "graphql": "16.11.0",
    "graphql-request": "6.1.0",
    "graphql-tag": "2.12.6",
    "lodash": "4.17.21",
    "viem": "2.33.2"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "@tanstack/react-query": "5.80.7",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-graphql-request": "5.0.0",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@types/node": "22.15.32",
    "merkletreejs": "0.3.11",
    "msw": "2.10.2",
    "vite": "6.3.5",
    "vitest": "2.1.9"
  },
  "scripts": {
    "format": "biome format . --write",
    "build": "tsc -p ./tsconfig.build.json",
    "format-and-lint": "bun format && bun lint:fix:unsafe",
    "lint": "biome check .",
    "lint:all": "bun lint:fix:unsafe && bun lint:types",
    "lint:fix": "bun lint --apply",
    "lint:fix:unsafe": "bun lint --write --unsafe",
    "lint:types": "tsc",
    "codegen": "gql-gen --config codegen.yml",
    "test": "vitest run -c ./vitest.config.ts",
    "watch": "tsc -p ./tsconfig.build.json --watch"
  }
}
