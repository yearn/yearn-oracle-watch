{
  "name": "@yearn-oracle-watch/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@rainbow-me/rainbowkit": "2.2.7",
    "@tailwindcss/vite": "4.1.10",
    "@tanstack/react-query": "5.80.7",
    "@yearn-oracle-watch/contracts": "workspace:*",
    "@yearn-oracle-watch/sdk": "workspace:*",
    "init": "0.1.2",
    "lucide-react": "0.534.0",
    "notistack": "3.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-modal-hook": "3.0.2",
    "react-router-dom": "7.6.2",
    "shadcn": "2.10.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.10",
    "tw-animate-css": "1.3.6",
    "viem": "2.33.2",
    "wagmi": "2.15.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.7.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "25.0.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-svgr": "4.3.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9"
  },
  "scripts": {
    "start": "vite",
    "serve": "vite preview",
    "build": "vite build",
    "clean:cache": "rm -rf node_modules/.vite",
    "format": "biome format . --write",
    "format-and-lint": "bun run format && bun run lint:fix:unsafe",
    "lint": "biome check .",
    "lint:all": "bun run lint:fix:unsafe && bun run lint:types",
    "lint:fix": "bun run lint --apply",
    "lint:fix:unsafe": "bun run lint --write --unsafe",
    "lint:types": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
